{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kastel",
  "scopeName": "source.kastel",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#function-header"
    },
    {
      "include": "#catch-clause"
    },
    {
      "include": "#variable-annotation"
    },
    {
      "include": "#type-alias"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.kastel",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.kastel",
          "match": "//.*$"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.kastel"
            },
            "2": {
              "name": "entity.name.function.kastel"
            }
          }
        },
        {
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.kastel"
            },
            "2": {
              "name": "entity.name.type.class.kastel"
            }
          }
        },
        {
          "match": "\\b(interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.interface.kastel"
            },
            "2": {
              "name": "entity.name.type.interface.kastel"
            }
          }
        },
        {
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.enum.kastel"
            },
            "2": {
              "name": "entity.name.type.enum.kastel"
            }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.alias.kastel"
            },
            "2": {
              "name": "entity.name.type.alias.kastel"
            }
          }
        },
        {
          "match": "\\b(from)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.kastel"
            },
            "2": {
              "name": "entity.name.namespace.kastel"
            }
          }
        },
        {
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.kastel"
            },
            "2": {
              "name": "entity.name.namespace.kastel"
            }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.const.kastel"
            },
            "2": {
              "name": "variable.other.constant.definition.kastel"
            }
          }
        },
        {
          "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.let.kastel"
            },
            "2": {
              "name": "variable.other.definition.kastel"
            }
          }
        },
        {
          "name": "storage.modifier.kastel",
          "match": "\\b(public|private|protected|static|export|async)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.kastel",
          "match": "\\b(if|else|while|for|in|match|return|break|continue)\\b"
        },
        {
          "name": "keyword.control.exception.kastel",
          "match": "\\b(try|catch|finally|throw)\\b"
        },
        {
          "name": "keyword.control.async.kastel",
          "match": "\\bawait\\b"
        },
        {
          "name": "keyword.operator.is.kastel",
          "match": "\\bis\\b"
        },
        {
          "name": "keyword.operator.new.kastel",
          "match": "\\bnew\\b"
        },
        {
          "name": "keyword.control.import.kastel",
          "match": "\\b(import|from|as)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.kastel",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.none.kastel",
          "match": "\\bNone\\b"
        },
        {
          "name": "variable.language.self.kastel",
          "match": "\\bself\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.capability.kastel",
          "match": "\\b(Add|Sub|Mul|Div|Mod|Neg|BitNot|BitAnd|BitOr|BitXor|ShiftLeft|ShiftRight|Eq|Ord|Index|IndexMut)\\b"
        },
        {
          "name": "entity.name.type.primitive.kastel",
          "match": "\\b(int|float|str|bool|void|dynamic|any|None)\\b"
        },
        {
          "name": "entity.name.type.builtin.kastel",
          "match": "\\b(List|Dict|Set|Tuple|Range|Option|Result|Task|Channel|Mutex|Semaphore|WaitGroup|Iterator|Iterable|Self)\\b"
        },
        {
          "name": "support.function.constructor.kastel",
          "match": "\\b(Some|Ok|Err)\\b(?=\\s*\\()"
        },
        {
          "name": "constant.other.kastel",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        },
        {
          "name": "entity.name.type.kastel",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.kastel",
          "match": "\\b(print|println|type|clock|exit|channel|spawn|join|yield|sleep|select|process_run)\\b(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.method.kastel",
          "match": "(?<=[A-Za-z0-9_)\\]\"\\']\\.)[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.call.kastel",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.property.kastel",
          "match": "(?<=[A-Za-z0-9_)\\]\"\\']\\.)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.kastel",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.kastel",
              "match": "\\\\[nrt\"\\'\\\\]"
            }
          ]
        },
        {
          "name": "string.quoted.single.kastel",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.kastel",
              "match": "\\\\[nrt\"\\'\\\\]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.kastel",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.kastel",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.kastel",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.kastel",
          "match": "\\b\\d[\\d_]*(?:[eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.kastel",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.range.kastel",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.bitwise.shift.kastel",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.kastel",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.kastel",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.compound.kastel",
          "match": "[+\\-*/%]="
        },
        {
          "name": "keyword.operator.bitwise.kastel",
          "match": "&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.arithmetic.kastel",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.question.kastel",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.assignment.kastel",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.kastel",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.kastel",
          "match": ";"
        },
        {
          "name": "punctuation.accessor.kastel",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.colon.kastel",
          "match": ":"
        }
      ]
    },
    "type-core": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "name": "keyword.operator.arrow.kastel",
          "match": "->"
        },
        {
          "name": "entity.name.type.primitive.kastel",
          "match": "\\b(int|float|str|bool|void|dynamic|any|None)\\b"
        },
        {
          "name": "entity.name.type.capability.kastel",
          "match": "\\b(Add|Sub|Mul|Div|Mod|Neg|BitNot|BitAnd|BitOr|BitXor|ShiftLeft|ShiftRight|Eq|Ord|Index|IndexMut)\\b"
        },
        {
          "name": "entity.name.type.builtin.kastel",
          "match": "\\b(List|Dict|Set|Tuple|Range|Option|Result|Task|Channel|Mutex|Semaphore|WaitGroup|Iterator|Iterable|Self)\\b"
        },
        {
          "name": "entity.name.namespace.kastel",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\.[A-Za-z_])"
        },
        {
          "name": "punctuation.accessor.kastel",
          "match": "\\."
        },
        {
          "name": "entity.name.type.kastel",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "meta.type.parameters.kastel",
          "begin": "<",
          "end": ">",
          "patterns": [
            {
              "include": "#type-expression"
            },
            {
              "name": "punctuation.separator.comma.kastel",
              "match": ","
            }
          ]
        },
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#type-expression"
            },
            {
              "name": "punctuation.separator.comma.kastel",
              "match": ","
            }
          ]
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "include": "#type-expression"
            },
            {
              "name": "punctuation.separator.comma.kastel",
              "match": ","
            }
          ]
        },
        {
          "name": "keyword.operator.type.union.kastel",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.type.constraint.kastel",
          "match": "\\+"
        },
        {
          "name": "keyword.operator.type.optional.kastel",
          "match": "\\?"
        }
      ]
    },
    "type-record": {
      "name": "meta.type.record.kastel",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "name": "variable.other.property.kastel",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)"
        },
        {
          "name": "punctuation.separator.colon.kastel",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.kastel",
          "match": ","
        },
        {
          "include": "#type-expression"
        }
      ]
    },
    "type-expression": {
      "patterns": [
        {
          "include": "#type-record"
        },
        {
          "include": "#type-core"
        }
      ]
    },
    "generic-params": {
      "name": "meta.type.parameters.kastel",
      "begin": "<",
      "end": ">",
      "patterns": [
        {
          "begin": ":",
          "end": "(?=,|>)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.separator.colon.kastel"
            }
          },
          "patterns": [
            {
              "include": "#type-core"
            }
          ]
        },
        {
          "name": "entity.name.type.parameter.kastel",
          "match": "[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "punctuation.separator.comma.kastel",
          "match": ","
        }
      ]
    },
    "parameter-list": {
      "name": "meta.parameters.kastel",
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "begin": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
          "end": "(?=,|\\)|=)",
          "name": "meta.type.annotation.kastel",
          "beginCaptures": {
            "1": {
              "name": "variable.parameter.kastel"
            },
            "2": {
              "name": "punctuation.separator.colon.kastel"
            }
          },
          "patterns": [
            {
              "include": "#type-expression"
            }
          ]
        },
        {
          "name": "variable.parameter.kastel",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*[,)=])"
        },
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            }
          ]
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#constants"
        },
        {
          "name": "keyword.operator.assignment.kastel",
          "match": "="
        },
        {
          "name": "punctuation.separator.comma.kastel",
          "match": ","
        }
      ]
    },
    "function-header": {
      "name": "meta.function.kastel",
      "begin": "\\b(func)\\b",
      "end": "(?=\\{|;)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.function.kastel"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\G\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.kastel"
            }
          }
        },
        {
          "include": "#generic-params"
        },
        {
          "include": "#parameter-list"
        },
        {
          "name": "meta.return-type.kastel",
          "begin": "(->)\\s*",
          "end": "(?=\\{|;)",
          "beginCaptures": {
            "1": {
              "name": "keyword.operator.arrow.kastel"
            }
          },
          "patterns": [
            {
              "include": "#type-core"
            }
          ]
        }
      ]
    },
    "catch-clause": {
      "begin": "\\b(catch)\\b",
      "end": "(?=\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.exception.kastel"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#parameter-list"
        }
      ]
    },
    "variable-annotation": {
      "name": "meta.type.annotation.kastel",
      "begin": "\\b(let|const)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
      "end": "(?=[=;]|$)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.let.kastel"
        },
        "2": {
          "name": "variable.other.definition.kastel"
        },
        "3": {
          "name": "punctuation.separator.colon.kastel"
        }
      },
      "patterns": [
        {
          "include": "#type-expression"
        }
      ]
    },
    "type-alias": {
      "name": "meta.type.alias.kastel",
      "begin": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(<[^>]*>)?\\s*(=)",
      "end": "(?=;)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.alias.kastel"
        },
        "2": {
          "name": "entity.name.type.alias.kastel"
        },
        "3": {
          "patterns": [
            {
              "include": "#generic-params"
            }
          ]
        },
        "4": {
          "name": "keyword.operator.assignment.kastel"
        }
      },
      "patterns": [
        {
          "include": "#type-expression"
        }
      ]
    }
  }
}