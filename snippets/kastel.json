{
  "Fonction": {
    "prefix": "func",
    "body": [
      "func ${1:nom}(${2:x: int}) -> ${3:int} {",
      "\t$0",
      "}"
    ],
    "description": "Déclaration de fonction"
  },
  "Fonction générique": {
    "prefix": "gfunc",
    "body": [
      "func ${1:nom}<${2:T}>(${3:x}: ${2}) -> ${2} {",
      "\t$0",
      "}"
    ],
    "description": "Fonction générique : func nom<T>(x: T) -> T"
  },
  "Fonction générique bornée": {
    "prefix": "gfuncb",
    "body": [
      "func ${1:nom}<${2:T}: ${3:Add} + ${4:Eq}>(${5:a}: ${2}, ${6:b}: ${2}) -> ${2} {",
      "\t$0",
      "}"
    ],
    "description": "Paramètre générique avec bornes (capabilities séparées par +)"
  },
  "Fonction statique": {
    "prefix": "sfunc",
    "body": [
      "static func ${1:nom}(${2}) -> ${3:int} {",
      "\t$0",
      "}"
    ],
    "description": "Fonction statique (dans une classe)"
  },
  "Fonction async": {
    "prefix": "afunc",
    "body": [
      "async func ${1:nom}(${2}) -> ${3:int} {",
      "\t$0",
      "}"
    ],
    "description": "Fonction asynchrone"
  },
  "Fonction exportée": {
    "prefix": "efunc",
    "body": [
      "export func ${1:nom}(${2}) -> ${3:int} {",
      "\t$0",
      "}"
    ],
    "description": "Fonction exportée"
  },
  "Fonction générique exportée": {
    "prefix": "efuncg",
    "body": [
      "export func ${1:nom}<${2:T}>(${3:x}: ${2}) -> ${2} {",
      "\t$0",
      "}"
    ],
    "description": "Fonction générique exportée"
  },
  "Fonction async exportée": {
    "prefix": "eafunc",
    "body": [
      "export async func ${1:nom}(${2}) -> ${3:int} {",
      "\t$0",
      "}"
    ],
    "description": "Fonction asynchrone exportée"
  },
  "Fonction main": {
    "prefix": "main",
    "body": [
      "func main() {",
      "\t$0",
      "}"
    ],
    "description": "Point d'entrée"
  },
  "Méthode privée": {
    "prefix": "pfunc",
    "body": [
      "private func ${1:nom}(${2}) -> ${3:int} {",
      "\t$0",
      "}"
    ],
    "description": "Méthode privée (visible seulement via self)"
  },
  "Variable": {
    "prefix": "let",
    "body": "let ${1:nom}: ${2:int} = ${3:0};",
    "description": "Variable typée"
  },
  "Constante": {
    "prefix": "const",
    "body": "const ${1:NOM}: ${2:int} = ${3:0};",
    "description": "Constante"
  },
  "Constante exportée": {
    "prefix": "econst",
    "body": "export const ${1:NOM}: ${2:int} = ${3:0};",
    "description": "Constante exportée"
  },
  "Classe": {
    "prefix": "class",
    "body": [
      "class ${1:Nom} {",
      "\tprivate let ${2:valeur}: ${3:int};",
      "",
      "\tfunc initialize(${2}: ${3}) {",
      "\t\tself.${2} = ${2};",
      "\t}",
      "",
      "\t$0",
      "}"
    ],
    "description": "Classe avec constructeur initialize"
  },
  "Classe générique": {
    "prefix": "classg",
    "body": [
      "class ${1:Boite}<${2:T}> {",
      "\tprivate let ${3:valeur}: ${2};",
      "",
      "\tfunc initialize(${3}: ${2}) {",
      "\t\tself.${3} = ${3};",
      "\t}",
      "",
      "\tfunc get_${3}() -> ${2} {",
      "\t\treturn self.${3};",
      "\t}",
      "",
      "\t$0",
      "}"
    ],
    "description": "Classe générique : new Boite<int>(1)"
  },
  "Classe exportée": {
    "prefix": "eclass",
    "body": [
      "export class ${1:Nom} {",
      "\tprivate let ${2:valeur}: ${3:int};",
      "",
      "\tfunc initialize(${2}: ${3}) {",
      "\t\tself.${2} = ${2};",
      "\t}",
      "",
      "\t$0",
      "}"
    ],
    "description": "Classe exportée"
  },
  "Constructeur": {
    "prefix": [
      "init",
      "initialize"
    ],
    "body": [
      "func initialize(${1}) {",
      "\t$0",
      "}"
    ],
    "description": "Constructeur (initialize ; surcharge par arité, même visibilité)"
  },
  "Getter": {
    "prefix": "getter",
    "body": [
      "func get_${1:nom}() -> ${2:int} {",
      "\treturn self.${1};",
      "}"
    ],
    "description": "Getter get_<champ> (le champ et la méthode partagent le même espace de noms)"
  },
  "Setter": {
    "prefix": "setter",
    "body": [
      "func set_${1:nom}(${1}: ${2:int}) {",
      "\tself.${1} = ${1};",
      "}"
    ],
    "description": "Setter set_<champ>"
  },
  "Getter et setter": {
    "prefix": "getset",
    "body": [
      "func get_${1:nom}() -> ${2:int} {",
      "\treturn self.${1};",
      "}",
      "",
      "func set_${1}(${1}: ${2}) {",
      "\tself.${1} = ${1};",
      "}"
    ],
    "description": "Getter et setter d'un champ"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Nom} {",
      "\tfunc ${2:methode}(${3}) -> ${4:int};",
      "}"
    ],
    "description": "Interface"
  },
  "Interface générique": {
    "prefix": "interfaceg",
    "body": [
      "interface ${1:Container}<${2:T}> {",
      "\tfunc ${3:put}(${4:item}: ${2});",
      "\tfunc ${5:take}() -> Option<${2}>;",
      "}"
    ],
    "description": "Interface générique"
  },
  "Interface exportée": {
    "prefix": "einterface",
    "body": [
      "export interface ${1:Nom} {",
      "\tfunc ${2:methode}(${3}) -> ${4:int};",
      "}"
    ],
    "description": "Interface exportée"
  },
  "Classe implémentant une interface": {
    "prefix": "classi",
    "body": [
      "class ${1:Nom} : ${2:Interface} {",
      "\t$0",
      "}"
    ],
    "description": "Classe implémentant une ou plusieurs interfaces (class A : I, J)"
  },
  "Opérateur + (Add)": {
    "prefix": "opadd",
    "body": [
      "class ${1:Money} : Add {",
      "\tfunc add(other: ${1}) -> ${1} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Capability Add : Add seul = Add<Self, Self>"
  },
  "Opérateur hétérogène (Mul)": {
    "prefix": "opmul",
    "body": [
      "class ${1:Vec2} : Mul<${2:float}, ${1}> {",
      "\tfunc mul(other: ${2}) -> ${1} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Capability Mul<Rhs, Output>"
  },
  "Égalité (Eq)": {
    "prefix": "opeq",
    "body": [
      "class ${1:Money} : Eq<${1}> {",
      "\tfunc equals(other: ${1}) -> bool {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Capability Eq<Rhs> : méthode equals"
  },
  "Ordre (Ord)": {
    "prefix": "opord",
    "body": [
      "class ${1:Money} : Ord<${1}> {",
      "\tfunc compare(other: ${1}) -> int {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Capability Ord<Rhs> : méthode compare (négatif, 0, positif)"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Color} {",
      "\t${2:Red},",
      "\t${3:Green},",
      "\t${4:Blue}",
      "}"
    ],
    "description": "Énumération"
  },
  "Enum exportée": {
    "prefix": "eenum",
    "body": [
      "export enum ${1:Color} {",
      "\t${2:Red},",
      "\t${3:Green},",
      "\t${4:Blue}",
      "}"
    ],
    "description": "Énumération exportée"
  },
  "Alias de type": {
    "prefix": "type",
    "body": "type ${1:Nom} = ${2:int} | ${3:float};",
    "description": "Alias de type (union possible)"
  },
  "Alias Record": {
    "prefix": "typer",
    "body": "type ${1:Person} = { ${2:name}: ${3:str}, ${4:age}: ${5:int} };",
    "description": "Alias de type Record"
  },
  "Alias générique": {
    "prefix": "typeg",
    "body": "type ${1:Pair}<${2:A}, ${3:B}> = (${2}, ${3});",
    "description": "Alias de type générique"
  },
  "Alias exporté": {
    "prefix": "etype",
    "body": "export type ${1:Person} = { ${2:name}: ${3:str}, ${4:age}: ${5:int} };",
    "description": "Alias de type exporté"
  },
  "spawn_task": {
    "prefix": "spawntask",
    "body": [
      "export func ${1:spawn_task}<${2:T}>(task: func() -> ${2}) -> Task<${2}> {",
      "\treturn spawn(task);",
      "}"
    ],
    "description": "Lance une tâche coopérative sans argument (std/thread.ks)"
  },
  "spawn_task avec argument": {
    "prefix": "spawntaska",
    "body": [
      "export func ${1:spawn_task}<${2:A}, ${3:T}>(task: func(${2}) -> ${3}, arg: ${2}) -> Task<${3}> {",
      "\treturn spawn(task, arg);",
      "}"
    ],
    "description": "Surcharge avec argument : spawn(fonction, ...args)"
  },
  "Spawn": {
    "prefix": "spawn",
    "body": "let ${1:task} = spawn(${2:fonction}${3});",
    "description": "Lance une tâche : spawn(fonction, ...args) -> Task<T>"
  },
  "Await": {
    "prefix": "await",
    "body": "await ${1:task}",
    "description": "Attend le résultat d'une tâche / d'un appel async"
  },
  "Type fonction": {
    "prefix": "ftype",
    "body": "func(${1:A}) -> ${2:T}",
    "description": "Type fonction (paramètre ou annotation)"
  },
  "Canal": {
    "prefix": "channel",
    "body": "let ${1:ch} = channel(${2});",
    "description": "Canal (capacité optionnelle)"
  },
  "Import": {
    "prefix": "import",
    "body": "import ${1:std.math};",
    "description": "Import de module (math.sqrt(...))"
  },
  "Import nommé": {
    "prefix": "importn",
    "body": "import ${1:std.math} { ${2:sqrt} };",
    "description": "import module { a, b as c };"
  },
  "Import depuis": {
    "prefix": "importf",
    "body": "import { ${1:nom} } from ${2:module};",
    "description": "import { a, b as c } from module;"
  },
  "From import": {
    "prefix": "from",
    "body": "from ${1:module} import { ${2:nom} };",
    "description": "from module import { a, b as c };"
  },
  "Import tout": {
    "prefix": "importstar",
    "body": "import * from ${1:module};",
    "description": "Importe tous les exports"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "Condition"
  },
  "If / else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "Condition avec else"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "Boucle while"
  },
  "For in": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} {",
      "\t$0",
      "}"
    ],
    "description": "Boucle for … in"
  },
  "For tuple": {
    "prefix": "fort",
    "body": [
      "for (${1:a}, ${2:b}) in ${3:items} {",
      "\t$0",
      "}"
    ],
    "description": "Destructuration de tuple : éléments de type Tuple (ou dynamic)"
  },
  "For liste": {
    "prefix": "forl",
    "body": [
      "for [${1:a}, ${2:b}] in ${3:rows} {",
      "\t$0",
      "}"
    ],
    "description": "Destructuration de liste : éléments de type List"
  },
  "For entries": {
    "prefix": "fore",
    "body": [
      "for [${1:key}, ${2:value}] in ${3:dict}.entries() {",
      "\t$0",
      "}"
    ],
    "description": "Clé et valeur d'un Dict (entries() produit des listes)"
  },
  "For sur intervalle": {
    "prefix": "forr",
    "body": [
      "for ${1:i} in ${2:0}..${3:10} {",
      "\t$0",
      "}"
    ],
    "description": "Intervalle (.. exclusif, ..= inclusif)"
  },
  "Try / catch / finally": {
    "prefix": "try",
    "body": [
      "try {",
      "\t$1",
      "} catch (${2:e}) {",
      "\t$3",
      "} finally {",
      "\t$0",
      "}"
    ],
    "description": "Gestion d'exceptions"
  },
  "Try / catch typé": {
    "prefix": "trytype",
    "body": [
      "try {",
      "\t$1",
      "} catch (${2:e}: ${3:Err}) {",
      "\t$0",
      "}"
    ],
    "description": "catch avec annotation de type"
  },
  "Throw": {
    "prefix": "throw",
    "body": "throw ${1:\"message\"};",
    "description": "Lève une exception"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:valeur} {",
      "\t${2:pattern} => ${3:expression},",
      "\t_ => ${0:expression},",
      "}"
    ],
    "description": "Pattern matching (garde : pattern if cond => …)"
  },
  "Match Option": {
    "prefix": [
      "matchopt",
      "matchr"
    ],
    "body": [
      "match ${1:valeur} {",
      "\tSome(${2:v}) => ${3:expression},",
      "\tNone => ${0:expression},",
      "}"
    ],
    "description": "Match sur Option"
  },
  "Match Result": {
    "prefix": "matchres",
    "body": [
      "match ${1:valeur} {",
      "\tOk(${2:v}) => ${3:expression},",
      "\tErr(${4:e}) => ${0:expression},",
      "}"
    ],
    "description": "Match sur Result"
  },
  "Print": {
    "prefix": "pr",
    "body": "print(${1});",
    "description": "Affichage"
  },
  "Println": {
    "prefix": "prl",
    "body": "println(${1});",
    "description": "Affichage avec retour à la ligne"
  },
  "Lambda": {
    "prefix": "lambda",
    "body": "(${1:x}) => ${2:x}",
    "description": "Fonction fléchée"
  },
  "Fonction anonyme": {
    "prefix": "anon",
    "body": [
      "func(${1:x}) {",
      "\treturn $0;",
      "}"
    ],
    "description": "Fonction anonyme"
  },
  "Fonction anonyme typée": {
    "prefix": "anont",
    "body": [
      "func(${1:x}: ${2:int}) -> ${3:int} {",
      "\treturn $0;",
      "}"
    ],
    "description": "Fonction anonyme typée"
  },
  "Ternaire": {
    "prefix": "ternary",
    "body": "${1:condition} ? ${2:a} : ${3:b}",
    "description": "Opérateur ternaire"
  },
  "New": {
    "prefix": "new",
    "body": "new ${1:Classe}(${2})",
    "description": "Instanciation"
  },
  "New générique": {
    "prefix": "newg",
    "body": "new ${1:Classe}<${2:int}>(${3})",
    "description": "Instanciation générique"
  },
  "Littéral List": {
    "prefix": "list",
    "body": "[${1:1}, ${2:2}, ${3:3}]",
    "description": "Littéral de liste"
  },
  "Littéral Set": {
    "prefix": "set",
    "body": "{${1:1}, ${2:2}, ${3:3}}",
    "description": "Littéral d'ensemble (équivaut à Set(1, 2, 3))"
  },
  "Littéral Dict": {
    "prefix": "dict",
    "body": "{\"${1:cle}\": ${2:valeur}, \"${3:cle2}\": ${4:valeur2}}",
    "description": "Littéral de dict (clés chaînes)"
  },
  "Littéral Record": {
    "prefix": "record",
    "body": "{ ${1:name}: ${2:\"Bruno\"}, ${3:age}: ${4:25} }",
    "description": "Littéral de record (clés identifiants)"
  },
  "Littéral Tuple": {
    "prefix": "tuple",
    "body": "(${1:a}, ${2:b})",
    "description": "Tuple"
  },
  "Tuple à un élément": {
    "prefix": "tuple1",
    "body": "(${1:a},)",
    "description": "Tuple à un élément (virgule obligatoire)"
  },
  "Set vide": {
    "prefix": "emptyset",
    "body": "Set()",
    "description": "Ensemble vide ({} est un dict vide)"
  },
  "Dict vide": {
    "prefix": "emptydict",
    "body": "{}",
    "description": "Dict vide"
  },
  "Variable List": {
    "prefix": "letlist",
    "body": "let ${1:xs}: List<${2:int}> = [${3:1, 2, 3}];",
    "description": "Liste typée"
  },
  "Variable Set": {
    "prefix": "letset",
    "body": "let ${1:s}: Set<${2:int}> = {${3:1, 2, 3}};",
    "description": "Ensemble typé"
  },
  "Variable Dict": {
    "prefix": "letdict",
    "body": "let ${1:d}: Dict<str, ${2:int}> = {\"${3:a}\": ${4:1}};",
    "description": "Dict typé"
  },
  "Variable Record": {
    "prefix": "letrecord",
    "body": "let ${1:p}: { ${2:name}: ${3:str}, ${4:age}: ${5:int} } = { ${2}: ${6:\"Bruno\"}, ${4}: ${7:25} };",
    "description": "Record typé"
  },
  "Variable Tuple": {
    "prefix": "lettuple",
    "body": "let ${1:t} = (${2:1}, ${3:\"a\"});",
    "description": "Tuple"
  },
  "Variable fonction": {
    "prefix": "letfn",
    "body": "let ${1:f}: func(${2:int}) -> ${3:int} = (${4:x}) => ${5:x};",
    "description": "Variable de type fonction"
  }
}