{
  "Fonction": {
    "prefix": "func",
    "body": [
      "func ${1:nom}(${2:x: int}) -> ${3:int} {",
      "\t$0",
      "}"
    ],
    "description": "Déclaration de fonction"
  },
  "Fonction statique": {
    "prefix": "sfunc",
    "body": [
      "static func ${1:nom}(${2}) -> ${3:int} {",
      "\t$0",
      "}"
    ],
    "description": "Fonction statique de classe"
  },
  "Variable": {
    "prefix": "let",
    "body": "let ${1:nom}: ${2:int} = ${3:0};",
    "description": "Variable typée"
  },
  "Classe": {
    "prefix": "class",
    "body": [
      "class ${1:Nom} {",
      "\tprivate let ${2:valeur}: ${3:int} = 0;",
      "",
      "\tfunc initialize(${2}: ${3}) {",
      "\t\tself.${2} = ${2};",
      "\t}",
      "",
      "\t$0",
      "}"
    ],
    "description": "Classe avec constructeur initialize"
  },
  "Constructeur": {
    "prefix": "init",
    "body": [
      "func initialize(${1}) {",
      "\t$0",
      "}"
    ],
    "description": "Constructeur initialize"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Nom} {",
      "\tfunc ${2:methode}(${3}) -> ${4:int};",
      "}"
    ],
    "description": "Interface"
  },
  "Classe implémentant une interface": {
    "prefix": "classi",
    "body": [
      "class ${1:Nom} : ${2:Interface} {",
      "\t$0",
      "}"
    ],
    "description": "Classe implémentant une interface"
  },
  "Opérateur + (Add)": {
    "prefix": "opadd",
    "body": [
      "class ${1:Money} : Add {",
      "\tfunc add(other: ${1}) -> ${1} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Surcharge de l'opérateur + via la capability Add"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Color} {",
      "\t${2:Red},",
      "\t${3:Green},",
      "\t${4:Blue}",
      "}"
    ],
    "description": "Énumération"
  },
  "Alias de type": {
    "prefix": "type",
    "body": "type ${1:Nom} = ${2:int} | ${3:float};",
    "description": "Alias de type (union possible)"
  },
  "Alias Record": {
    "prefix": "typer",
    "body": "type ${1:Person} = { ${2:name}: ${3:str}, ${4:age}: ${5:int} };",
    "description": "Alias de type Record"
  },
  "Import": {
    "prefix": "import",
    "body": "import ${1:std.math};",
    "description": "Import de module"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "Condition"
  },
  "If / else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "Condition avec else"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "Boucle while"
  },
  "For in": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} {",
      "\t$0",
      "}"
    ],
    "description": "Boucle for … in"
  },
  "Try / catch / finally": {
    "prefix": "try",
    "body": [
      "try {",
      "\t$1",
      "} catch (${2:e}: Err) {",
      "\t$3",
      "} finally {",
      "\t$0",
      "}"
    ],
    "description": "Gestion d'exceptions"
  },
  "Fonction async": {
    "prefix": "afunc",
    "body": [
      "async func ${1:nom}(${2}) -> ${3:int} {",
      "\t$0",
      "}"
    ],
    "description": "Fonction asynchrone"
  },
  "Fonction main": {
    "prefix": "main",
    "body": [
      "func main() {",
      "\t$0",
      "}"
    ],
    "description": "Point d'entrée"
  },
  "Print": {
    "prefix": "pr",
    "body": "print(${1});",
    "description": "Affichage"
  },
  "Constante": {
    "prefix": "const",
    "body": "const ${1:NOM}: ${2:int} = ${3:0};",
    "description": "Constante"
  },
  "Lambda": {
    "prefix": "lambda",
    "body": "(${1:x}) => ${2:x}",
    "description": "Fonction fléchée"
  },
  "For sur intervalle": {
    "prefix": "forr",
    "body": [
      "for ${1:i} in ${2:0}..${3:10} {",
      "\t$0",
      "}"
    ],
    "description": "Boucle sur un intervalle (.. exclusif, ..= inclusif)"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:valeur} {",
      "\t${2:pattern} => ${3:expression},",
      "\t_ => ${0:expression},",
      "}"
    ],
    "description": "Pattern matching (garde possible : pattern if cond => …)"
  },
  "Match Option/Result": {
    "prefix": "matchr",
    "body": [
      "match ${1:valeur} {",
      "\tSome(${2:v}) => ${3:expression},",
      "\tNone => ${0:expression},",
      "}"
    ],
    "description": "Match sur Option"
  },
  "Match Result": {
    "prefix": "matchres",
    "body": [
      "match ${1:valeur} {",
      "\tOk(${2:v}) => ${3:expression},",
      "\tErr(${4:e}) => ${0:expression},",
      "}"
    ],
    "description": "Match sur Result"
  },
  "Import depuis": {
    "prefix": "importf",
    "body": "import { ${1:nom} } from ${2:module};",
    "description": "Import nommé"
  },
  "From import": {
    "prefix": "from",
    "body": "from ${1:module} import { ${2:nom} };",
    "description": "from … import"
  },
  "Export func": {
    "prefix": "efunc",
    "body": [
      "export func ${1:nom}(${2}) -> ${3:int} {",
      "\t$0",
      "}"
    ],
    "description": "Fonction exportée"
  },
  "Littéral List": {
    "prefix": "list",
    "body": "[${1:1}, ${2:2}, ${3:3}]",
    "description": "Littéral de liste"
  },
  "Littéral Set": {
    "prefix": "set",
    "body": "{${1:1}, ${2:2}, ${3:3}}",
    "description": "Littéral d'ensemble (équivaut à Set(1, 2, 3))"
  },
  "Littéral Dict": {
    "prefix": "dict",
    "body": "{\"${1:cle}\": ${2:valeur}, \"${3:cle2}\": ${4:valeur2}}",
    "description": "Littéral de dict (clés chaînes)"
  },
  "Littéral Record": {
    "prefix": "record",
    "body": "{ ${1:name}: ${2:\"Bruno\"}, ${3:age}: ${4:25} }",
    "description": "Littéral de record (clés identifiants)"
  },
  "Littéral Tuple": {
    "prefix": "tuple",
    "body": "(${1:a}, ${2:b})",
    "description": "Tuple"
  },
  "Tuple à un élément": {
    "prefix": "tuple1",
    "body": "(${1:a},)",
    "description": "Tuple à un élément (virgule obligatoire)"
  },
  "Set vide": {
    "prefix": "emptyset",
    "body": "Set()",
    "description": "Ensemble vide ({} est un dict vide)"
  },
  "Dict vide": {
    "prefix": "emptydict",
    "body": "{}",
    "description": "Dict vide"
  },
  "Variable List": {
    "prefix": "letlist",
    "body": "let ${1:xs}: List<${2:int}> = [${3:1, 2, 3}];",
    "description": "Liste typée"
  },
  "Variable Set": {
    "prefix": "letset",
    "body": "let ${1:s}: Set<${2:int}> = {${3:1, 2, 3}};",
    "description": "Ensemble typé"
  },
  "Variable Dict": {
    "prefix": "letdict",
    "body": "let ${1:d}: Dict<str, ${2:int}> = {\"${3:a}\": ${4:1}};",
    "description": "Dict typé"
  },
  "Variable Record": {
    "prefix": "letrecord",
    "body": "let ${1:p}: { ${2:name}: ${3:str}, ${4:age}: ${5:int} } = { ${2}: ${6:\"Bruno\"}, ${4}: ${7:25} };",
    "description": "Record typé"
  },
  "Variable Tuple": {
    "prefix": "lettuple",
    "body": "let ${1:t} = (${2:1}, ${3:\"a\"});",
    "description": "Tuple"
  },
  "Fonction anonyme": {
    "prefix": "anon",
    "body": [
      "func(${1:x}) {",
      "\treturn $0;",
      "}"
    ],
    "description": "Fonction anonyme"
  },
  "Ternaire": {
    "prefix": "ternary",
    "body": "${1:condition} ? ${2:a} : ${3:b}",
    "description": "Opérateur ternaire"
  },
  "New": {
    "prefix": "new",
    "body": "new ${1:Classe}(${2})",
    "description": "Instanciation"
  },
  "New générique": {
    "prefix": "newg",
    "body": "new ${1:Classe}<${2:int}>(${3})",
    "description": "Instanciation générique"
  }
}